#
# openi2pd: i2pd.service.
#
# Native systemd unit that runs i2pd in the foreground as the i2pd user with
# packaged configuration, tunnel directory and runtime/data paths. Logging goes
# to the journal; the daemon never forks and no readiness protocol is used.
#

[Unit]
Description=openi2pd router
Documentation=man:i2pd(1) https://github.com/daviduhden/openi2pd
Wants=network-online.target
After=network-online.target
# A crashing router is retried, but not in an unbounded loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=i2pd
Group=i2pd
# The daemon keeps its router keys, netDb and default TUI/torrent IPC socket
# under StateDirectory; the pidfile lives in RuntimeDirectory.
StateDirectory=i2pd
StateDirectoryMode=0700
RuntimeDirectory=i2pd
RuntimeDirectoryMode=0700
# The packaged unit logs to the journal, but an administrator may select
# `log = file` with `logfile = /var/log/i2pd/i2pd.log`. LogsDirectory creates
# that directory with the service account as owner and makes it writable under
# ProtectSystem=strict, so the documented opt-in does not fail at first write.
LogsDirectory=i2pd
LogsDirectoryMode=0700
UMask=0077
WorkingDirectory=/var/lib/i2pd

ExecStart=/usr/bin/i2pd --conf=/etc/i2pd/i2pd.conf --tunconf=/etc/i2pd/tunnels.conf --tunnelsdir=/etc/i2pd/tunnels.conf.d --certsdir=/usr/share/i2pd/certificates --datadir=/var/lib/i2pd --pidfile=/run/i2pd/i2pd.pid --service --foreground --log=stdout
# SIGHUP reloads tunnel configuration without restarting the router.
ExecReload=/bin/kill -HUP $MAINPID

# SIGINT performs the slower graceful shutdown: the router stops accepting new
# transit tunnels and gives them up to ten minutes (600 s) to expire, then runs
# its ordered stop (flush state, stop the IPC workers). SIGKILL is only a last
# resort inside the 60-second shutdown margin.
#
# KillMode=mixed sends the stop signal to the main process only and SIGKILL to
# the whole cgroup at the deadline. That is the required split: signalling the
# workers directly would terminate a storage worker in the middle of a write
# while the router still believes it owns the operation. The main process owns
# worker shutdown; do not widen the stop signal to the whole cgroup.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=660
SendSIGKILL=yes
Restart=on-failure
RestartSec=5s
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
# `open-i2pd` is a frozen compatibility identifier for journal filtering and
# rsyslog rules; it is not the product name. The product is `openi2pd` and the
# unit is `i2pd.service`. Change this only with a journal-filter migration note.
SyslogIdentifier=open-i2pd

# Hardening. The local TUI/torrent IPC socket lives in the data directory and
# must remain usable, so no PrivateNetwork and no filesystem filtering of
# AF_UNIX are applied. No RestrictAddressFamilies rule is used either: the
# router needs AF_INET and AF_INET6 and interface discovery uses netlink.
NoNewPrivileges=yes
ProtectSystem=strict
# Add any overridden datadir, pidfile directory or TUI socket directory here.
# StateDirectory/RuntimeDirectory/LogsDirectory add their paths automatically;
# keep the TUI socket outside /tmp: PrivateTmp makes that directory
# namespace-private.
ReadWritePaths=/var/lib/i2pd /run/i2pd
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# The router runs unprivileged and needs no capabilities. Binding a privileged
# port requires an explicit override: add CAP_NET_BIND_SERVICE to both
# CapabilityBoundingSet and AmbientCapabilities.
CapabilityBoundingSet=
# Do not add a SystemCallFilter without a tested allow-list for OpenSSL,
# networking and the IPC worker; a partial filter would break the router.

[Install]
WantedBy=multi-user.target
