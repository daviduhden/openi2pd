# and license details.
#
# openi2pd: i2pd.upstart.
#
# Upstart job that starts the forking i2pd daemon with file logging and
# overridable init settings.
#

description "openi2pd router"

start on runlevel [2345]
stop on runlevel [016] or unmounting-filesystem

# these can be overridden in /etc/init/i2pd.override
env LOGFILE="/var/log/i2pd/i2pd.log"

expect fork

exec /usr/bin/i2pd --daemon --service --log=file --logfile=$LOGFILE
