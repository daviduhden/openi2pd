# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.upstart.
#
# Native Upstart job that keeps the router in the foreground as the i2pd
# account. Upstart supervises the main process, applies the private umask and
# uses SIGINT with a bounded stop timeout. The job is retained for legacy
# Upstart hosts; current packages select systemd, OpenRC, runit, s6/s6-rc,
# Shepherd or SysVinit.
#
# The packaged /var/lib/i2pd directory must exist and be owned by i2pd before
# the job starts. Upstart's setuid stanza can apply to job scripts, so this
# definition deliberately has no root pre-start hook; it uses syslog and keeps
# the pidfile under the data directory instead of /run because the job cannot
# create /run/i2pd as root. This is the only sample with that pidfile path.
#
# Sample only: I2PD_SERVICE_MANAGER does not offer Upstart, so CMake does not
# install this file. It is retained for legacy hosts and must be copied into
# /etc/init by the operator. AppArmor attaches by executable path, so the
# packaged profile covers this job without a stanza here.
#

description "openi2pd router"

start on runlevel [2345]
# unmounting-filesystem stops the router before a filesystem that holds its data
# directory disappears, which is the case in container and teardown scripts.
stop on runlevel [016] or unmounting-filesystem

# The router already logs through syslog. Keep Upstart's own console capture
# explicit so an early startup failure before syslog is connected is still
# recorded in /var/log/upstart/i2pd.log instead of being discarded. With
# --log=syslog the daemon's own records still go to syslog; only output from
# before that sink exists lands here.
console log

respawn
# Upstart's own window: at most five respawns in 60 s, after which the job is
# left stopped and an operator has to start it again. This is the manager-native
# value, not the systemd five-per-300 s ladder.
respawn limit 5 60

# Identity and limits for the exec'd process. The router never needs root, and
# the umask keeps newly created keys and state private.
setuid i2pd
setgid i2pd
chdir /var/lib/i2pd
umask 0077
limit nofile 8192 8192

# SIGINT requests the daemon's graceful transit-tunnel drain. Escalate only
# after the documented ten-minute drain plus a shutdown margin: `kill timeout`
# is the interval between this signal and SIGKILL. A second SIGINT ends the
# drain immediately.
kill signal INT
kill timeout 660

exec /usr/bin/i2pd \
	--service \
	--foreground \
	--conf=/etc/i2pd/i2pd.conf \
	--tunconf=/etc/i2pd/tunnels.conf \
	--tunnelsdir=/etc/i2pd/tunnels.conf.d \
	--certsdir=/usr/share/i2pd/certificates \
	--datadir=/var/lib/i2pd \
	--pidfile=/var/lib/i2pd/i2pd.pid \
	--log=syslog
