#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: log/run.
#
# runit log service. Create the private log directory as root and hand it to
# the i2pd account before starting svlogd. The logger is supervised separately
# from the router and rotates its own `current` file.
#
# svlogd reads the router's stdout on stdin; -tt prefixes each line with a
# TAI64N timestamp and a human-readable timestamp, and log/config supplies the
# rotation policy (rotate at 1 MiB, keep ten old files). The 077 mask keeps
# `current` and every rotated file at 0600 inside a 0700 directory, the same
# policy as the systemd LogsDirectory=, the tmpfiles entry, the Debian
# maintainer script and the SysV script: router logs are never group- or
# world-accessible. This script needs root only for install; chpst drops to
# i2pd before svlogd starts. It never creates the router's pidfile and does not
# stop the router when it exits.
#

set -eu
umask 077

# The directory is dedicated to svlogd: install applies this owner and mode
# even when the directory already exists.
/usr/bin/install -d -m 0700 -o i2pd -g i2pd /var/log/i2pd

exec 2>&1
exec /usr/bin/chpst -u i2pd:i2pd /usr/bin/svlogd -tt /var/log/i2pd
