#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: run.
#
# runit run script. Prepare the private runtime and data directories as root,
# then replace the shell with the router running as i2pd. The router stays in
# the foreground and writes its log to stdout for the companion svlogd
# service; runsv owns restart and stop handling.
#

set -eu
umask 077

# Fail once with a clear diagnostic instead of entering runsv's respawn loop
# because the account or the packaged configuration is missing.
if ! id -u i2pd >/dev/null 2>&1; then
	printf '%s\n' "i2pd: service account 'i2pd' does not exist" >&2
	exit 1
fi
if [ ! -r /etc/i2pd/i2pd.conf ]; then
	printf '%s\n' "i2pd: /etc/i2pd/i2pd.conf is not readable" >&2
	exit 1
fi

/usr/bin/install -d -m 0700 -o i2pd -g i2pd /run/i2pd
/usr/bin/install -d -m 0700 -o i2pd -g i2pd /var/lib/i2pd

exec 2>&1
# -o raises RLIMIT_NOFILE to the same 8192 used by the other definitions; the
# inherited runsvdir limit is otherwise unspecified. chpst execs, so i2pd stays
# the direct child of runsv and receives sv's signals.
exec /usr/bin/chpst -o 8192 -u i2pd:i2pd /usr/bin/i2pd \
	--service \
	--foreground \
	--conf=/etc/i2pd/i2pd.conf \
	--tunconf=/etc/i2pd/tunnels.conf \
	--tunnelsdir=/etc/i2pd/tunnels.conf.d \
	--certsdir=/usr/share/i2pd/certificates \
	--datadir=/var/lib/i2pd \
	--pidfile=/run/i2pd/i2pd.pid \
	--log=stdout
