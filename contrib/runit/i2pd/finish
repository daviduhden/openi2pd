#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: finish.
#
# runsv invokes this with the router exit code and termination status. If the
# service is still wanted, the pause slows retries for persistent startup
# failures. Never remove the daemon-owned pidfile here; its lifetime belongs
# to the router, not the finish script.
#

set -eu
umask 077

printf 'i2pd: run exited (code=%s status=%s); restarting in 5s\n' \
	"${1:-unknown}" "${2:-unknown}" >&2
/bin/sleep 5
exit 0
