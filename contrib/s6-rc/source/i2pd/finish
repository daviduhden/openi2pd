#!/bin/execlineb -S0
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: finish.
#
# s6-supervise runs this after the router exits. If the service is still
# wanted, the five-second pause slows retries for persistent startup failures;
# it stays below timeout-finish. Do not remove the daemon-owned pidfile here:
# the router owns its lifetime.
#

foreground { /bin/sleep 5 }
