#!/bin/execlineb -P
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: run.
#
# s6-rc longrun run script that prepares the runtime and data directories,
# drops to the i2pd account and executes the router in the foreground.
# s6-rc orders the service; s6-supervise performs the actual supervision.
#
# Companion files in this source definition: type (longrun), down-signal (INT,
# the graceful drain), timeout-kill (660000 ms before SIGKILL), timeout-finish
# (10000 ms for the finish script) and dependencies.d/base. The kill window is
# the 600 s transit-tunnel drain plus a 60 s margin for the ordered stop; trust
# the s6-svstat state rather than the s6-rc command's return to decide that the
# router has stopped. No readiness file is shipped, so bringing the service up
# does not prove the router joined the network. This script must start as root
# because it creates directories and changes user; everything after
# s6-setuidgid runs as i2pd. Logging goes to syslog. The daemon argv must stay
# identical to the plain s6 run script; the static service contract compares
# the two.
#

# The system supervision tree normally runs as root. install creates the
# runtime directory on tmpfs and the data directory with a private mode before
# privileges are dropped. Both commands run in the foreground so execline
# continues with the next instruction after they finish.
foreground { /usr/bin/install -d -m 0700 -o i2pd -g i2pd /run/i2pd }
foreground { /usr/bin/install -d -m 0700 -o i2pd -g i2pd /var/lib/i2pd }

# Apply the same private creation mask as the packaged systemd/SysV services.
umask 0077

# Raise RLIMIT_NOFILE before dropping privileges, matching the 8192 used by
# the other service definitions; the inherited supervisor limit is otherwise
# unspecified. s6-softlimit applies to this process and its children.
s6-softlimit -o 8192

# setgid and setuid are performed before exec. i2pd must stay in the
# foreground; --service selects the system paths and implies no daemonization.
s6-setuidgid i2pd
/usr/bin/i2pd \
  --service \
  --foreground \
  --conf=/etc/i2pd/i2pd.conf \
  --tunconf=/etc/i2pd/tunnels.conf \
  --tunnelsdir=/etc/i2pd/tunnels.conf.d \
  --datadir=/var/lib/i2pd \
  --certsdir=/usr/share/i2pd/certificates \
  --pidfile=/run/i2pd/i2pd.pid \
  --log=syslog
