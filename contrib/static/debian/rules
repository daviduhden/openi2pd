#!/usr/bin/make -f
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: rules.
#
# Debian packaging rules for the prebuilt static i2pd binary; installation is
# performed directly and compilation, tests and stripping are skipped.
#

include /usr/share/dpkg/architecture.mk

PKG := debian/i2pd

%:
	dh $@

override_dh_auto_build override_dh_auto_test override_dh_auto_clean override_dh_auto_configure:

override_dh_auto_install:
	install -D -m 0755 bin/i2pd-$(DEB_HOST_ARCH) $(PKG)/usr/bin/i2pd
	install -D -m 0644 src/contrib/i2pd.conf $(PKG)/etc/i2pd/i2pd.conf
	install -D -m 0644 src/contrib/tunnels.conf $(PKG)/etc/i2pd/tunnels.conf
	install -D -m 0644 src/contrib/subscriptions.txt $(PKG)/etc/i2pd/subscriptions.txt
	install -D -m 0644 src/contrib/tunnels.d/README $(PKG)/etc/i2pd/tunnels.conf.d/README
	install -d $(PKG)/usr/share/i2pd
	cp -r src/contrib/certificates $(PKG)/usr/share/i2pd/

override_dh_installsystemd:
	dh_installsystemd --no-start

override_dh_strip override_dh_dwz override_dh_shlibdeps override_dh_makeshlibs:

override_dh_builddeb:
	dh_builddeb -- -Zxz

# dh_installinit owns the single enable/start/stop action through invoke-rc.d,
# which reaches i2pd.service on a systemd host and /etc/init.d/i2pd otherwise.
# dh_installsystemd remains at its default --no-start to avoid a second action.
