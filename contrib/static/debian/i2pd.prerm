#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.prerm.
#
# Debian pre-remove script that stops the SysV init service on remove, upgrade
# or deconfigure when systemd is not running. DEBHELPER placeholders are
# preserved.
#

set -e

if [ ! -d /run/systemd/system ] && [ -x /etc/init.d/i2pd ]; then
  case "$1" in
    remove|upgrade|deconfigure) invoke-rc.d i2pd stop || true ;;
  esac
fi

#DEBHELPER#

exit 0
