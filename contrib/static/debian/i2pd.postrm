#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.postrm.
#
# Debian post-remove script that, on purge, removes the init registration and
# the i2pd configuration, data, log and run directories. DEBHELPER
# placeholders are preserved for generated maintainer scripts.
#

set -e

if [ "$1" = "purge" ]; then
	# Removal preserves state; purge intentionally deletes configuration, logs
	# and router data, including any identity keys in the data directory.
	update-rc.d i2pd remove >/dev/null || true
	rm -f /etc/default/i2pd
	rm -rf /etc/i2pd
	rm -rf /var/lib/i2pd
	rm -rf /var/log/i2pd
	rm -rf /run/i2pd
fi

#DEBHELPER#

exit 0
