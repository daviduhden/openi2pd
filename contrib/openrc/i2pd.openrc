#!/sbin/openrc-run
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.openrc.
#
# OpenRC runscript that keeps i2pd in the foreground under supervise-daemon.
# The service uses the packaged configuration, a private data directory and a
# private runtime directory. The daemon creates, locks and removes its own
# pidfile; OpenRC keeps its supervisor state separately.
#
# shellcheck disable=SC2034
# The command_*, supervisor, respawn_*, stopsig, retry, umask and description
# assignments below are consumed by the OpenRC runscript framework, not by
# this shell fragment directly.
#

: "${I2PD_USER:=i2pd}"
: "${I2PD_GROUP:=i2pd}"
: "${I2PD_CONF:=/etc/i2pd/i2pd.conf}"
: "${I2PD_TUNCONF:=/etc/i2pd/tunnels.conf}"
: "${I2PD_TUNNELSDIR:=/etc/i2pd/tunnels.conf.d}"
: "${I2PD_CERTSDIR:=/usr/share/i2pd/certificates}"
: "${I2PD_DATADIR:=/var/lib/i2pd}"
: "${I2PD_RUNDIR:=/run/i2pd}"
: "${I2PD_PIDFILE:=${I2PD_RUNDIR}/i2pd.pid}"
: "${I2PD_LOG:=file}"
: "${I2PD_LOGDIR:=/var/log/i2pd}"
: "${I2PD_LOGFILE:=/var/log/i2pd/i2pd.log}"
: "${I2PD_OPTS:=}"

name="i2pd"
description="openi2pd router"
command="/usr/bin/i2pd"
command_user="${I2PD_USER}:${I2PD_GROUP}"
directory="${I2PD_DATADIR}"
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=5
# Match the packaged systemd StartLimitIntervalSec=300/StartLimitBurst=5 so a
# crash loop is treated the same way on both managers.
respawn_period=300
# Keep the stop signal and its retry budget in one knob. supervise-daemon's
# --retry grammar is SIGNAL/TIMEOUT (the man page uses SIGTERM/5), so the
# SIG-prefixed form is the canonical one; INT/660 is accepted as well. SIGINT
# selects the daemon's ten-minute transit-tunnel drain, SIGTERM the prompt
# ordered shutdown.
: "${stopsig:=SIGTERM}"
case "${stopsig}" in
	SIGINT|INT) : "${retry:=SIGINT/660}" ;;
	SIGTERM|TERM) : "${retry:=SIGTERM/30}" ;;
	SIGHUP|HUP) : "${retry:=SIGHUP/30}" ;;
	*) : "${retry:=${stopsig}/30}" ;;
esac
# Keep the creation mask private for everything the service creates. The
# directory modes are additionally set explicitly by start_pre.
umask=0077
# OpenRC applies rc_ulimit through the shell's ulimit built-in before it
# starts the supervised process. Keep the same descriptor budget as the other
# managers; a non-root invocation can only raise it within the inherited hard
# limit.
: "${rc_ulimit:=-n 8192}"
# required_files and required_dirs are preconditions checked by OpenRC as part
# of the start action; the runscript creates the data/runtime/log paths but never
# the packaged configuration or tunnel directory. A missing entry fails the start
# with OpenRC's own diagnostic instead of a daemon parsing error.
required_files="${I2PD_CONF} ${I2PD_TUNCONF}"
required_dirs="${I2PD_TUNNELSDIR}"

# The command line is expanded into one string and split on whitespace by the
# runscript framework, so a path or value containing spaces would become two
# arguments. I2PD_OPTS is appended unquoted and is therefore word-split as well;
# use it only for additional options, never for secrets (it is visible in the
# process list).
command_args="--service --foreground --conf=${I2PD_CONF} --tunconf=${I2PD_TUNCONF} --tunnelsdir=${I2PD_TUNNELSDIR} --certsdir=${I2PD_CERTSDIR} --datadir=${I2PD_DATADIR} --pidfile=${I2PD_PIDFILE} --log=${I2PD_LOG}"
case "${I2PD_LOG}" in
	file)
		command_args="${command_args} --logfile=${I2PD_LOGFILE}"
		;;
	syslog)
		;;
	stdout)
		# Let supervise-daemon capture stdout so output is not discarded when
		# OpenRC is not attached to a tty.
		output_log="${I2PD_LOGFILE}"
		error_log="${I2PD_LOGFILE}"
		;;
esac

if [ -n "${I2PD_OPTS}" ]; then
	command_args="${command_args} ${I2PD_OPTS}"
fi

depend() {
	need localmount
	use net
	use logger
	after bootmisc
}

start_pre() {
	case "${I2PD_LOG}" in
		file|syslog|stdout)
			;;
		*)
			eerror "I2PD_LOG must be 'file', 'syslog' or 'stdout'"
			return 1
			;;
	esac

	# A failed checkpath must abort the start. Without the explicit checks,
	# OpenRC reports only a later "failed to start" with no path or mode.
	# The configured directories and log file are service-owned paths:
	# checkpath may apply the requested owner and mode to existing entries.
	checkpath -d -m 0700 -o "${I2PD_USER}:${I2PD_GROUP}" "$(dirname "${I2PD_PIDFILE}")" \
		|| { eerror "Cannot create or own $(dirname "${I2PD_PIDFILE}")"; return 1; }
	checkpath -d -m 0700 -o "${I2PD_USER}:${I2PD_GROUP}" "${I2PD_DATADIR}" \
		|| { eerror "Cannot create or own ${I2PD_DATADIR}"; return 1; }

	case "${I2PD_LOG}" in
		file)
			checkpath -d -m 0750 -o "${I2PD_USER}:${I2PD_GROUP}" "${I2PD_LOGDIR}" \
				|| { eerror "Cannot create or own ${I2PD_LOGDIR}"; return 1; }
			checkpath -f -m 0640 -o "${I2PD_USER}:${I2PD_GROUP}" "${I2PD_LOGFILE}" \
				|| { eerror "Cannot create or own ${I2PD_LOGFILE}"; return 1; }
			;;
		syslog)
			;;
		*)
			checkpath -d -m 0750 -o "${I2PD_USER}:${I2PD_GROUP}" "${I2PD_LOGDIR}" \
				|| { eerror "Cannot create or own ${I2PD_LOGDIR}"; return 1; }
			checkpath -f -m 0600 -o "${I2PD_USER}:${I2PD_GROUP}" "${I2PD_LOGFILE}" \
				|| { eerror "Cannot create or own ${I2PD_LOGFILE}"; return 1; }
			;;
	esac
}

extra_commands="${extra_commands} reload reopenlogs"
description_reload="Reload tunnel configuration (SIGHUP)"
description_reopenlogs="Reopen log files (SIGUSR1)"

reload() {
	ebegin "Reloading ${name}"
	# --signal must stay before the service name: supervise-daemon is a musl
	# binary, and musl's argument parser does not permute options after operands.
	supervise-daemon --signal HUP "${RC_SVCNAME}"
	eend $?
}

reopenlogs() {
	ebegin "Reopening ${name} logs"
	# SIGUSR1 makes the daemon reopen its log file after external rotation.
	supervise-daemon --signal USR1 "${RC_SVCNAME}"
	eend $?
}
