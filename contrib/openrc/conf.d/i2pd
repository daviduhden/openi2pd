# openi2pd: i2pd conf.d.
#
# Defaults for /etc/init.d/i2pd. Enable or disable the service with
# rc-update; this file intentionally has no enable switch.
#

# Account that owns the router process and its data, runtime and log paths.
# The account must already exist; the runscript does not create it.
I2PD_USER="i2pd"
I2PD_GROUP="i2pd"

# Packaged configuration and tunnel definitions.
I2PD_CONF="/etc/i2pd/i2pd.conf"
I2PD_TUNCONF="/etc/i2pd/tunnels.conf"
I2PD_TUNNELSDIR="/etc/i2pd/tunnels.conf.d"
I2PD_CERTSDIR="/usr/share/i2pd/certificates"

# Router data (keys, netDb, profiles) and runtime state. Both directories are
# created with mode 0700 and owned by I2PD_USER:I2PD_GROUP. The daemon creates
# and locks I2PD_PIDFILE itself; do not pre-create or remove it by hand.
I2PD_DATADIR="/var/lib/i2pd"
I2PD_RUNDIR="/run/i2pd"
I2PD_PIDFILE="/run/i2pd/i2pd.pid"

# Log destination: file, syslog or stdout.
#   file   - i2pd writes I2PD_LOGFILE directly (default)
#   syslog - i2pd uses the system logger; no log file or log directory is
#            created and the service is ordered after logger when present
#   stdout - supervise-daemon captures stdout/stderr into I2PD_LOGFILE
# I2PD_LOGDIR must be a dedicated directory; it is forced to mode 0750.
# I2PD_LOGFILE should be inside it and is forced to 0640 for file logging or
# 0600 for captured stdout.
I2PD_LOG="file"
I2PD_LOGDIR="/var/log/i2pd"
I2PD_LOGFILE="/var/log/i2pd/i2pd.log"

# The runscript sets rc_ulimit="-n 8192" for the same descriptor budget as the
# other managers. A non-root start can only select a value within the inherited
# hard limit; override rc_ulimit here when a site needs a different value.

# Extra daemon options appended to the service command line. Use this only for
# options that the runscript does not already set; a duplicate option can make
# config parsing fail. This file is root-controlled and its contents are
# visible in the process list, so never put secrets here.
I2PD_OPTS=""

# OpenRC stops the service with SIGTERM so that stop is prompt. To request the
# daemon's ten-minute graceful tunnel drain, set stopsig to SIGINT; the
# runscript derives retry from it. Use SIGTERM when prompt shutdown is desired.
#stopsig="SIGINT"
