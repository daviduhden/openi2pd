#
# openi2pd: openi2pd.desktop.
#
# Desktop launcher for the openi2pd terminal user interface. The
# launcher must not start a second unmanaged router; it opens the TUI
# client in a terminal and the packaged service remains the only router
# process.
#

[Desktop Entry]
Type=Application
Version=1.0
Name=openi2pd TUI
GenericName=I2P Router Console
Comment=Monitor and control the openi2pd router
Exec=i2pd-tui
Icon=openi2pd
Terminal=true
Categories=Network;P2P;
Keywords=I2P;anonymous;privacy;router;console;
StartupNotify=false
