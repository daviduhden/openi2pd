#
# openi2pd: openi2pd.desktop.
#
# Desktop launcher for the openi2pd router. It starts the i2pd executable as a
# graphical application and exposes the installed icon, category and search
# keywords to the desktop environment.
#

[Desktop Entry]
Type=Application
Version=1.0
Name=openi2pd
GenericName=I2P Router
Comment=Anonymous I2P network router
Exec=i2pd
Icon=openi2pd
Terminal=false
Categories=Network;P2P;
Keywords=I2P;anonymous;privacy;router;
StartupNotify=false
