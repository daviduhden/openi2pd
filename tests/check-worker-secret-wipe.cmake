# Prepared source contract; execution belongs to manual CI.
function(worker_stack_secrets_guarded source output)
  # Exclude the semicolon from matches so CMake lists preserve each item.
  set(declaration "std::array<uint8_t,[ \t\r\n]*WORKER_HELLO_(NONCE_SIZE|SIZE)>[ \t\r\n]+([A-Za-z_][A-Za-z0-9_]*)[ \t\r\n]*[{][ \t\r\n]*[}]")
  string(REGEX MATCHALL "${declaration}" declarations "${source}")
  list(LENGTH declarations count)
  set(remaining "${source}")
  set(valid TRUE)
  if(count LESS 8)
    set(valid FALSE)
  endif()
  foreach(item IN LISTS declarations)
    string(REGEX MATCH "${declaration}" matched "${item}")
    set(name "${CMAKE_MATCH_2}")
    string(FIND "${remaining}" "${item}" position)
    string(LENGTH "${item}" length)
    math(EXPR after "${position} + ${length}")
    string(SUBSTRING "${remaining}" ${after} -1 remaining)
    if(NOT remaining MATCHES "^;[ \t\r\n]+StackSecretWipe ${name}Wipe [(]${name}[)];")
      set(valid FALSE)
    endif()
  endforeach()
  set(${output} "${valid}" PARENT_SCOPE)
endfunction()

file(READ "${PROJECT_ROOT}/privsep/Worker.cpp" worker_secrets)
worker_stack_secrets_guarded("${worker_secrets}" guarded)
if(NOT guarded)
  message(FATAL_ERROR "Every stack worker identity copy needs lifetime wiping")
endif()
foreach(name IN ITEMS nonce record fixed buffer)
  string(REPLACE "StackSecretWipe ${name}Wipe (${name});" "" mutated "${worker_secrets}")
  if(mutated STREQUAL worker_secrets)
    message(FATAL_ERROR "Worker secret mutation did not change ${name}")
  endif()
  worker_stack_secrets_guarded("${mutated}" accepted)
  if(accepted)
    message(FATAL_ERROR "Worker identity contract accepts unguarded ${name}")
  endif()
endforeach()
