# openi2pd: compile-free initial NTCP2 request deadline contract.

if(NOT PROJECT_ROOT)
  message(FATAL_ERROR "PROJECT_ROOT is required")
endif()
file(READ "${PROJECT_ROOT}/libi2pd/NTCP2.cpp" source)
foreach(method IN ITEMS ServerLogin ScheduleInitialReadDeadline CancelInitialReadDeadline HandleInitialReadDeadline)
  string(FIND "${source}" "void NTCP2Session::${method} (" ${method}_begin)
  if(${method}_begin LESS 0)
    message(FATAL_ERROR "Missing initial NTCP2 deadline method: ${method}")
  endif()
endforeach()
math(EXPR length "${ScheduleInitialReadDeadline_begin} - ${ServerLogin_begin}")
string(SUBSTRING "${source}" ${ServerLogin_begin} ${length} login)
string(FIND "${login}" "ScheduleInitialReadDeadline ();" arm)
string(FIND "${login}" "boost::asio::async_read" read)
if(arm LESS 0 OR read LESS_EQUAL arm)
  message(FATAL_ERROR "Initial NTCP2 request deadline must precede its read")
endif()
foreach(required IN ITEMS "generation == self->m_InitialReadGeneration.load" "self = shared_from_this ()")
  string(FIND "${login}" "${required}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Initial NTCP2 read must retain buffer ownership and generation")
  endif()
endforeach()
math(EXPR length "${CancelInitialReadDeadline_begin} - ${ScheduleInitialReadDeadline_begin}")
string(SUBSTRING "${source}" ${ScheduleInitialReadDeadline_begin} ${length} timer)
foreach(required IN ITEMS "weak = weak_from_this ()" "m_InitialReadGeneration.fetch_add" "NTCP2_ESTABLISH_TIMEOUT")
  string(FIND "${timer}" "${required}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Initial NTCP2 timer lost weak ownership, generation or bound")
  endif()
endforeach()
math(EXPR length "${HandleInitialReadDeadline_begin} - ${CancelInitialReadDeadline_begin}")
string(SUBSTRING "${source}" ${CancelInitialReadDeadline_begin} ${length} cancellation)
foreach(required IN ITEMS "boost::asio::dispatch (m_Server.GetService ()"
    "weak = weak_from_this ()" "generation == self->m_InitialReadGeneration.load"
    "self->m_InitialReadTimer.cancel ();" "m_InitialReadGeneration.fetch_add")
  string(FIND "${cancellation}" "${required}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Initial NTCP2 cancellation must dispatch with weak generation authority")
  endif()
endforeach()
file(READ "${PROJECT_ROOT}/libi2pd/NTCP2.h" header)
string(FIND "${header}" "std::atomic<uint64_t> m_InitialReadGeneration" atomic_generation)
if(atomic_generation LESS 0)
  message(FATAL_ERROR "Initial NTCP2 generation crosses executors and must be atomic")
endif()
string(FIND "${source}" "bool NTCP2Session::HasPendingIncomingData" end)
math(EXPR length "${end} - ${HandleInitialReadDeadline_begin}")
string(SUBSTRING "${source}" ${HandleInitialReadDeadline_begin} ${length} deadline)
foreach(required IN ITEMS "operation_aborted" "generation != m_InitialReadGeneration" "IsTerminated ()" "Terminate ();")
  string(FIND "${deadline}" "${required}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Initial NTCP2 expiry must reject stale authority and close")
  endif()
endforeach()

# The bounded stage ends before crypto work enters the other executor.
string(FIND "${source}" "void NTCP2Session::HandleSessionRequestReceived (" begin)
string(FIND "${source}" "void NTCP2Session::ProcessSessionRequest (" end)
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${source}" ${begin} ${length} completion)
string(FIND "${completion}" "CancelInitialReadDeadline ();" cancel)
string(FIND "${completion}" "boost::asio::post" post)
if(cancel LESS 0 OR post LESS_EQUAL cancel)
  message(FATAL_ERROR "Initial NTCP2 deadline must retire before crypto handoff")
endif()

foreach(method IN ITEMS Terminate Close)
  string(FIND "${source}" "void NTCP2Session::${method} ()" begin)
  string(SUBSTRING "${source}" ${begin} -1 suffix)
  string(FIND "${suffix}" "\n\tvoid NTCP2Session::" next)
  string(SUBSTRING "${suffix}" 0 ${next} body)
  string(FIND "${body}" "CancelInitialReadDeadline ();" cancel)
  if(cancel LESS 0)
    message(FATAL_ERROR "NTCP2 ${method} must retire the initial deadline")
  endif()
endforeach()
