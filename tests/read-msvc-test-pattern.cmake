#
# Resolve the closed PowerShell literal grammar used by the MSVC lane.
# This reads text only; no expression or command is evaluated.

function(read_msvc_test_pattern workflow_text out_pattern out_error)
  set(${out_pattern} "" PARENT_SCOPE)
  set(${out_error} "" PARENT_SCOPE)
  string(REGEX MATCHALL "[$]testPattern[ \t]*=" assignments "${workflow_text}")
  list(LENGTH assignments assignment_count)
  if(NOT assignment_count EQUAL 1)
    set(${out_error} "MSVC filter needs one literal assignment" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCH "[$]testPattern[ \t]*=" assignment "${workflow_text}")
  string(FIND "${workflow_text}" "${assignment}" start)
  string(LENGTH "${assignment}" assignment_length)
  math(EXPR start "${start} + ${assignment_length}")
  string(SUBSTRING "${workflow_text}" ${start} -1 tail)
  set(pattern "")
  set(parts 0)
  while(1)
    string(REGEX REPLACE "^[ \t\r\n]+" "" tail "${tail}")
    string(REGEX MATCH "^'([^'\r\n]*)'" literal "${tail}")
    if(NOT literal)
      set(${out_error} "MSVC filter accepts only single-quoted literals" PARENT_SCOPE)
      return()
    endif()
    string(APPEND pattern "${CMAKE_MATCH_1}")
    math(EXPR parts "${parts} + 1")
    if(parts GREATER 32)
      set(${out_error} "MSVC filter literal count exceeds the bound" PARENT_SCOPE)
      return()
    endif()
    string(LENGTH "${literal}" literal_length)
    string(SUBSTRING "${tail}" ${literal_length} -1 tail)
    string(REGEX MATCH "^[ \t\r\n]*[+]" continuation "${tail}")
    if(NOT continuation)
      break()
    endif()
    string(LENGTH "${continuation}" continuation_length)
    string(SUBSTRING "${tail}" ${continuation_length} -1 tail)
  endwhile()
  # The assignment must end at its newline. A command or variable after
  # a literal is not part of this deliberately restricted grammar.
  if(NOT tail MATCHES "^[ \t]*[\r\n]")
    set(${out_error} "MSVC filter assignment has trailing expression text" PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^[ \t\r\n]+" "" tail "${tail}")
  if(NOT tail MATCHES "^ctest[ \t]")
    set(${out_error} "MSVC filter is not followed by its CTest consumer" PARENT_SCOPE)
    return()
  endif()
  # Join only this command's backtick continuations, never later steps.
  set(command "")
  while(1)
    string(FIND "${tail}" "\n" newline)
    if(newline LESS 0)
      set(line "${tail}")
      set(tail "")
    else()
      string(SUBSTRING "${tail}" 0 ${newline} line)
      math(EXPR next "${newline} + 1")
      string(SUBSTRING "${tail}" ${next} -1 tail)
    endif()
    string(APPEND command " ${line}")
    if(NOT line MATCHES "`[ \t\r]*$")
      break()
    endif()
  endwhile()
  string(FIND "${command}" ";" command_separator)
  if(NOT command_separator EQUAL -1)
    set(${out_error} "MSVC CTest filter consumer cannot chain commands" PARENT_SCOPE)
    return()
  endif()
  string(REGEX MATCHALL "(^|[ \t])-R([ \t]|$)" filter_options "${command}")
  list(LENGTH filter_options filter_count)
  if(NOT filter_count EQUAL 1)
    set(${out_error} "MSVC CTest needs exactly one filter option" PARENT_SCOPE)
    return()
  endif()
  if(command MATCHES "(^|[ \t])#")
    set(${out_error} "MSVC CTest filter consumer cannot be a comment" PARENT_SCOPE)
    return()
  endif()
  if(NOT command MATCHES "-R[ \t]+[$]testPattern([ \t\r\n`]|$)")
    set(${out_error} "MSVC CTest must consume the resolved filter" PARENT_SCOPE)
    return()
  endif()
  # Retain the complete anchored regex, not just one passing member.
  set(expected "^(test-(tui-protocol|tui-terminal|tui-pipe-name|tui-win32-pipe|privsep-windows-(ipc|isolation|supervisor)|win32-shutdown-deadline|profile-static-lifetime|i2p-service-readiness|tunnel-destination-cache|destination-leaseset-session|deadline-mutex|child-stop-budget|atomic-shared-ptr|kad-dht|eddsa|signature-identity-hardening|crypto-audit-bounds|signed-data-bounds|command-line-policy|release-assertions)|command-line-policy-rejections|i2pd-command-line-policy)$")
  if(NOT pattern STREQUAL expected)
    set(${out_error} "MSVC CTest filter membership or anchors changed" PARENT_SCOPE)
    return()
  endif()
  set(${out_pattern} "${pattern}" PARENT_SCOPE)
endfunction()
