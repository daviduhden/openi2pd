#!/usr/bin/make -f
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: rules.
#
# Debhelper rules for the CMake/Ninja build. CMake installs runtime, tools,
# documentation and man pages into debian/tmp; debhelper assigns them to i2pd
# and i2pd-tui, loads the AppArmor profile and integrates systemd, SysV,
# sysusers, tmpfiles and logrotate.
#

# CMake is the only supported build system. This file is executed by
# debhelper, not by the project's POSIX make front-end. The direct CMake
# invocation bypasses dh_auto_configure, so pass the dpkg-buildflags values
# explicitly (including PIE/FORTIFY/RELRO/NOW) and enable the project's own
# hardening diagnostics.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CXXFLAGS_MAINT_APPEND = -Wall -pedantic

%:
	dh $@

override_dh_auto_configure:
	cmake -S build -B build-debian -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_SYSCONFDIR=/etc \
		-DCMAKE_INSTALL_LOCALSTATEDIR=/var \
		-DCMAKE_INSTALL_RUNSTATEDIR=/run \
		-DI2PD_BUILD_TUI=ON \
		-DI2PD_BUILD_TOOLS=ON \
		-DWITH_LIBRARY=OFF \
		-DCMAKE_C_FLAGS="$(shell dpkg-buildflags --get CFLAGS) $(shell dpkg-buildflags --get CPPFLAGS)" \
		-DCMAKE_CXX_FLAGS="$(shell dpkg-buildflags --get CXXFLAGS) $(shell dpkg-buildflags --get CPPFLAGS)" \
		-DCMAKE_EXE_LINKER_FLAGS="$(shell dpkg-buildflags --get LDFLAGS)" \
		-DCMAKE_SHARED_LINKER_FLAGS="$(shell dpkg-buildflags --get LDFLAGS)" \
		-DCMAKE_MODULE_LINKER_FLAGS="$(shell dpkg-buildflags --get LDFLAGS)" \
		-DBUILD_TESTING=OFF \
		-DI2PD_INSTALL_DOCS=ON \
		-DI2PD_INSTALL_CONFIG=ON \
		-DI2PD_OPENSSL_EXPECT=OpenSSL \
		-DI2PD_SERVICE_MANAGER=none

override_dh_auto_build:
	cmake --build build-debian --parallel \
		$(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS)))

override_dh_auto_test:
	# Unit tests belong to CI. Router tests need network fixtures and are not
	# run during a package build.
	@true

override_dh_auto_clean:
	cmake -E remove_directory build-debian

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp cmake --install build-debian

# dh_apparmor installs the local include and reloads the profile. The profile
# itself is in i2pd.install; running the helper after dh_install keeps the
# profile and the maintscript snippets in the same package.
override_dh_install:
	dh_install
	dh_apparmor --profile-name=usr.bin.i2pd -pi2pd

# Keep the SysV script for non-systemd systems. dh_installinit owns the single
# enable/start/stop action through invoke-rc.d, which reaches the native unit
# on a systemd host and the SysV script elsewhere. dh_installsystemd installs
# and enables the unit but must not add a second start/stop action.
override_dh_installinit:
	dh_installinit

override_dh_installsystemd:
	dh_installsystemd --no-start

override_dh_installtmpfiles:
	dh_installtmpfiles

override_dh_missing:
	dh_missing --fail-missing
