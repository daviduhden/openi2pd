# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.default.
#
# Defaults for the packaged SysV init script: enablement flag, extra daemon
# options and the open-file limit. The canonical script is
# contrib/sysvinit/i2pd.
#

# Defaults for the i2pd SysV init script
# sourced by /etc/init.d/i2pd
I2PD_ENABLED="yes"

# Additional options passed to the daemon.
# See /usr/share/doc/i2pd/docs/user-guide/configuration.md for the options.
DAEMON_OPTS=""

# Open-file limit applied by the init script before starting i2pd.
I2PD_NOFILE="8192"
