#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: postinst.
#
# Idempotently create the i2pd system user/group and the persistent state,
# log and runtime directories. Service start/stop is left to the debhelper
# systemd and SysV snippets.
#

set -e

I2PDHOME='/var/lib/i2pd'
I2PDUSER='i2pd'
LOGDIR='/var/log/i2pd'
LOGFILE="$LOGDIR/i2pd.log"
RUNDIR='/run/i2pd'

case "$1" in
  configure|reconfigure)
    if ! getent group "$I2PDUSER" >/dev/null 2>&1; then
      addgroup --system --quiet "$I2PDUSER"
    fi

    if ! getent passwd "$I2PDUSER" >/dev/null 2>&1; then
      adduser --system --quiet --ingroup "$I2PDUSER" \
        --home "$I2PDHOME" --no-create-home \
        --shell /usr/sbin/nologin "$I2PDUSER"
    fi

    # Create new paths with the packaged policy, but never reset an existing
    # administrator's ownership or mode on an upgrade. In particular a local
    # backup group or a deliberately group-readable log directory must survive
    # package upgrades.
    if [ ! -d "$I2PDHOME" ]; then
      install -d -o "$I2PDUSER" -g "$I2PDUSER" -m 0700 "$I2PDHOME"
    fi
    if [ ! -d "$LOGDIR" ]; then
      install -d -o "$I2PDUSER" -g "$I2PDUSER" -m 0700 "$LOGDIR"
    fi
    if [ ! -d "$RUNDIR" ]; then
      install -d -o "$I2PDUSER" -g "$I2PDUSER" -m 0700 "$RUNDIR"
    fi
    if [ ! -e "$LOGFILE" ]; then
      install -o "$I2PDUSER" -g "$I2PDUSER" -m 0600 /dev/null "$LOGFILE"
    fi
    ;;
  abort-upgrade|abort-remove|abort-deconfigure|triggered)
    ;;
  *)
    echo "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
