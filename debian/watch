opts="filenamemangle=s%(?:.*?)?v?(\d[\d.]*)\.tar\.gz%i2pd-$1.tar.gz%" \
   https://github.com/daviduhden/openi2pd/tags \
   (?:.*?/)?(\d[\d.]*)\.tar\.gz debian uupdate
