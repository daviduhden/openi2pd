# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: i2pd.install.
#
# Explicit daemon, tool, configuration, certificate, documentation, manpage and
# AppArmor payload. Paths without a destination are resolved in debian/tmp,
# which is populated by the CMake install; AppArmor comes from the source tree
# because CMake does not install a distribution profile. The ncurses binary,
# its desktop assets and its manpage belong to i2pd-tui.
#

# Router, i2pdctl and the fifteen native tools.
usr/bin/i2pd
usr/bin/i2pdctl
usr/bin/autoconf_i2pd
usr/bin/b33address
usr/bin/b33offlinekeys
usr/bin/famtool
usr/bin/i2pbase64
usr/bin/keygen
usr/bin/keyinfo
usr/bin/offlinekeys
usr/bin/regaddr
usr/bin/regaddr_3ld
usr/bin/regaddralias
usr/bin/routerinfo
usr/bin/vain
usr/bin/verifyhost
usr/bin/x25519

# Packaged configuration and certificates.
etc/i2pd/i2pd.conf
etc/i2pd/subscriptions.txt
etc/i2pd/tunnels.conf
etc/i2pd/tunnels.conf.d/README
etc/i2pd/tunnels.conf.d/IRC-Ilita.conf
etc/i2pd/tunnels.conf.d/IRC-Irc2P.conf
usr/share/i2pd/certificates usr/share/i2pd

# CMake Documentation component. Do not list the source docs/ or
# assets/branding directories here: dh_install would prefer the unfiltered
# source tree over debian/tmp and bypass the CMake pattern filter.
usr/share/doc/i2pd/ChangeLog
usr/share/doc/i2pd/LICENSE
usr/share/doc/i2pd/NOTICE
usr/share/doc/i2pd/README.md
usr/share/doc/i2pd/LICENSE.i2pd-tools
usr/share/doc/i2pd/CC-BY-SA-4.0
usr/share/doc/i2pd/docs
usr/share/doc/i2pd/assets

# Man pages are installed by the Runtime/Tools components, not by the optional
# documentation tree, so they survive -DI2PD_INSTALL_DOCS=OFF packaging.
usr/share/man/man1/i2pd.1
usr/share/man/man1/i2pdctl.1

# Distribution-specific AppArmor profile, loaded by dh_apparmor.
contrib/apparmor/usr.bin.i2pd etc/apparmor.d
