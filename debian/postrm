#!/bin/sh
# See the LICENSE file at the top of the project tree for copyright
# and license details.
#
# openi2pd: postrm.
#
# Persistent state and administrator configuration are removed only on purge.
# An ordinary remove or an upgrade leaves /var/lib/i2pd and /etc/i2pd intact.
#

set -e

#DEBHELPER#

case "$1" in
  purge)
    # Purge is destructive by design: the data directory can contain router
    # identity keys and other persistent state. A normal remove leaves it.
    rm -rf /etc/i2pd
    rm -rf /var/lib/i2pd
    rm -rf /var/log/i2pd
    rm -rf /run/i2pd
    rm -f /etc/default/i2pd
    ;;
esac

exit 0
