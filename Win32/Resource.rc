 *
 * openi2pd: Resource.
 *
 * Defines the English (United States) resources for the Windows build:
 * the MAINICON application and tray icon plus inclusion of the version
 * resource when not editing in App Studio.
 *
 */

#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "winres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_ENU)
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""winres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif		// APSTUDIO_INVOKED

MAINICON ICON "openi2pd.ico"
#endif		// English (United States) resources

#ifndef APSTUDIO_INVOKED
#include "Resource.rc2"
#endif		// not APSTUDIO_INVOKED
