openi2pd: AndroidManifest.

Defines native Android application resources.

-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The router is not a short-lived data transfer. Android 15
        limits dataSync foreground services to six hours per 24 hours
        and blocks them from BOOT_COMPLETED, so the long-running router
        uses specialUse (with dataSync retained for API 29..33, where
        specialUse does not exist). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- UPnP/SSDP discovers the local gateway and therefore needs
        multicast on Wi-Fi. Android 17 (API 37) also requires the
        runtime local-network permission before an app may access LAN
        devices. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".RouterApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenI2Pd">

        <!-- Separate-process SAF payload broker. It is non-exported and
            shares the application UID, so the extra process is crash/IO
            containment, not an Android permission boundary. Every root,
            handle, operation and export token is additionally bound to
            the creating (uid, pid), and no ParcelFileDescriptor ever
            crosses Binder. The process claims the storage-broker role
            once and installs its own sandbox. -->
        <service android:name=".TorrentSafStorageService" android:process=":torrent_storage"
            android:exported="false" android:stopWithTask="false" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- Same-process, non-exported router owner. The foreground
            notification and the graceful-stop deadline live here, not
            in an Activity, and task removal does not stop it. A future
            isolated-process design would add a separate process plus an
            AIDL IRouterControl interface; the local binder must never
            be exported. -->
        <service
            android:name=".RouterService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="i2p_router" />
        </service>

        <!-- The only exported components are the launcher Activity and
            the QS tile. The tile is protected by the system
            BIND_QUICK_SETTINGS_TILE permission; both launch no admin
            interface. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".I2PdQSTileService"
            android:exported="true"
            android:icon="@drawable/ic_logo_monochrome"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Boot and package-replace only resume an already requested
            run intent; they never start a router that the operator
            stopped. -->
        <receiver
            android:name="org.openi2pd.router.receivers.BootUpReceiver"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
