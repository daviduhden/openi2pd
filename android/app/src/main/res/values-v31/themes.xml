<resources>
    <!--
        Android 12+ system splash. The platform starting window uses the app
        icon; no core-splashscreen dependency is added. The adaptive
        foreground sits on the same white plate as the launcher icon, over the
        branded background, then the activity theme continues unchanged.
    -->
    <style name="Theme.OpenI2Pd" parent="Theme.OpenI2Pd.Base">
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowSplashScreenBackground">@color/brand_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
